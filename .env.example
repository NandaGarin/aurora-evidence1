# ============================================================================
# AURORA Evidence (Development 2) — contoh konfigurasi. TANPA SECRET.
# Salin menjadi .env lalu isi nilai lokal Anda. Backend memegang semua API key;
# jangan pernah menaruh secret pada VITE_* / frontend / bundle / fixture.
# ============================================================================

# --- Server ---
AURORA_DATA_DIR=./var
AURORA_HOST=127.0.0.1
AURORA_PORT=8102
AURORA_FRONTEND_PORT=5172
# Optional server-side Vite proxy target; defaults to local AURORA_PORT.
AURORA_API_INTERNAL_URL=

# --- Public/hardening (default lokal = false) ---
AURORA_PUBLIC=false
# Wajib saat AURORA_PUBLIC=true (>= 32 karakter acak). Dipakai semua request.
AURORA_API_TOKEN=
# Origin browser eksplisit, dipisah koma; wildcard ditolak.
AURORA_CORS=http://localhost:5172,http://127.0.0.1:5172
# Host HTTP yang diizinkan; ganti dengan domain deployment pada public mode.
AURORA_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# --- Limits ---
AURORA_MAX_UPLOAD_MB=10
AURORA_JOB_TIMEOUT=180
AURORA_MAX_PENDING=20
# Global time budget retrieval (detik) dan concurrency antar-sumber.
AURORA_RETRIEVAL_BUDGET_SECONDS=45
AURORA_RETRIEVAL_MAX_CONCURRENCY=6

# --- Mode default (demo | live). Demo = fixture berlabel, tanpa jaringan. ---
AURORA_MODE_DEFAULT=demo

# ============================================================================
# Provider retrieval (semua opsional; tanpa kunci -> status unconfigured).
# Local corpus (BM25) selalu tersedia tanpa kredensial.
# ============================================================================

# Web search: pilih salah satu adapter terdokumentasi.
# provider: none | tavily | serper
AURORA_WEBSEARCH_PROVIDER=none
AURORA_TAVILY_API_KEY=
AURORA_SERPER_API_KEY=

# Fact-check / MAFINDO (verifikasi endpoint dari dokumentasi resmi saat live).
AURORA_MAFINDO_API_KEY=
AURORA_MAFINDO_TIMEOUT_SECONDS=12

# Reverse image search (opsional). Local image index selalu tersedia.
# provider: none | serpapi | bing_visual
AURORA_IMAGE_PROVENANCE_PROVIDER=none
AURORA_SERPAPI_API_KEY=

# --- Dense retrieval (opsional). Tanpa ini, BM25-only tetap berfungsi. ---
AURORA_DENSE_ENABLED=false
AURORA_DENSE_MODEL=

# ============================================================================
# AI detector (forensic signals). Providernya DAPAT DIGANTI lewat config.
# Skor detector = indikasi asal konten, BUKAN label hoaks / stance faktual.
# ============================================================================

# Image detector. provider: none | fixture | sightengine | hive
AURORA_IMAGE_DETECTOR_PROVIDER=none
AURORA_SIGHTENGINE_API_USER=
AURORA_SIGHTENGINE_API_SECRET=
AURORA_HIVE_API_KEY=
AURORA_IMAGE_DETECTOR_TIMEOUT_SECONDS=45

# Text detector. provider: none | fixture | gptzero | copyleaks
AURORA_TEXT_DETECTOR_PROVIDER=none
AURORA_GPTZERO_API_KEY=
AURORA_COPYLEAKS_API_KEY=
AURORA_COPYLEAKS_EMAIL=
AURORA_TEXT_DETECTOR_TIMEOUT_SECONDS=45

# --- Frontend (build-time). Hanya URL backend, tidak boleh secret. ---
VITE_API_URL=http://127.0.0.1:8102
